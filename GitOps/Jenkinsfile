// =====================================================================================
// CD pipeline (Jenkins job: "Wanderlust-CD") - triggered by the CI pipeline
//
//   Validate tag -> Checkout main -> Update image tags in kubernetes/*.yaml
//   -> Commit + push to GitHub -> (Argo CD sees the commit and deploys to EKS)
//
// This job never talks to Kubernetes. It only changes Git. Argo CD does the deployment.
// =====================================================================================
pipeline {
    agent { label 'wanderlust-agent' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()          // two CD runs must never push at the same time
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Image tag built by the CI pipeline, e.g. 12-a1b2c3d')
    }

    environment {
        DEPLOY_BRANCH = 'main'             // the branch Argo CD watches
    }

    stages {
        stage('Validate Tag') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG is empty. This job is normally triggered by Wanderlust-CI.')
                    }
                    currentBuild.displayName = "#${env.BUILD_NUMBER} (${params.IMAGE_TAG})"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
                // checkout scm leaves a "detached HEAD"; put us on a real local branch
                // that matches the latest remote main, so we can commit and push.
                sh 'git checkout -B "$DEPLOY_BRANCH" "origin/$DEPLOY_BRANCH"'
            }
        }

        stage('Update Kubernetes Manifests') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker',
                                                  usernameVariable: 'DOCKERHUB_USER',
                                                  passwordVariable: 'DOCKERHUB_TOKEN')]) {
                    sh '''
                        bash scripts/update-image-tags.sh "$DOCKERHUB_USER" "$IMAGE_TAG" kubernetes
                        echo "----- changes -----"
                        git --no-pager diff -- kubernetes/
                    '''
                }
            }
        }

        stage('Commit and Push to GitHub') {
            steps {
                // 'github-cred' = GitHub username + Personal Access Token (repo scope).
                withCredentials([gitUsernamePassword(credentialsId: 'github-cred', gitToolName: 'Default')]) {
                    sh '''
                        git config user.name  "jenkins-cd"
                        git config user.email "jenkins-cd@users.noreply.github.com"

                        git add kubernetes/backend.yaml kubernetes/frontend.yaml
                        if git diff --cached --quiet; then
                            echo "Manifests already use tag $IMAGE_TAG - nothing to commit."
                            exit 0
                        fi

                        # [skip ci] stops this commit from re-triggering the CI pipeline.
                        git commit -m "cd: deploy image tag $IMAGE_TAG [skip ci]"

                        # If someone pushed to main while we worked, replay our commit on top.
                        git pull --rebase origin "$DEPLOY_BRANCH"
                        git push origin "HEAD:$DEPLOY_BRANCH"
                        echo "Pushed. Argo CD will detect commit $(git rev-parse --short HEAD) and deploy it."
                    '''
                }
            }
        }
    }

    post {
        success {
            emailext(
                to: '$DEFAULT_RECIPIENTS',
                subject: "DEPLOYED: wanderlust ${params.IMAGE_TAG} (${env.JOB_NAME} #${env.BUILD_NUMBER})",
                body: "Kubernetes manifests now point to image tag ${params.IMAGE_TAG}.\nArgo CD will sync it to EKS within ~3 minutes.\n\nBuild: ${env.BUILD_URL}",
                attachLog: true
            )
        }
        failure {
            emailext(
                to: '$DEFAULT_RECIPIENTS',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (tag ${params.IMAGE_TAG})",
                body: "The CD pipeline failed.\n\nBuild: ${env.BUILD_URL}\nConsole: ${env.BUILD_URL}console",
                attachLog: true
            )
        }
        cleanup {
            cleanWs()
        }
    }
}
